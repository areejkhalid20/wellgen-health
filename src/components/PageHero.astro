---
// Page banner: text on the left, photo in an arch on the right, over a steel-blue band.
import Breadcrumbs from './Breadcrumbs.astro';
import Photo from './Photo.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  lead: string;
  crumbs: { label: string; href?: string }[];
  image: { folder: string; name: string; alt: string };
  highlights?: string[];
}
const { title, lead, crumbs, image, highlights = [] } = Astro.props;
---
<section class="relative overflow-hidden bg-mist">
  <!-- steel-blue band behind the arch -->
  <div aria-hidden="true" class="absolute inset-y-0 right-0 hidden w-[38%] bg-brand lg:block"></div>
  <div aria-hidden="true" class="absolute -right-24 top-10 hidden size-72 rounded-full border-[28px] border-sky/30 lg:block"></div>

  <div class="relative mx-auto grid max-w-7xl gap-10 px-6 pb-14 pt-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:pb-20 lg:pt-12">
    <div class="flex flex-col justify-center">
      <div class="hero-rise"><Breadcrumbs items={crumbs} /></div>
      <h1 class="hero-rise mt-6 text-[2.6rem] font-medium leading-[1.05] tracking-[-0.01em] text-navy sm:text-5xl lg:text-[3.6rem]">{title}</h1>
      <p class="hero-rise-2 mt-5 max-w-[56ch] text-lg leading-relaxed text-muted">{lead}</p>
      <div class="hero-rise-3 mt-8 flex flex-wrap gap-3">
        <a href={site.bookingUrl} class="rounded-full bg-cta px-7 py-3.5 font-semibold text-white shadow-[0_10px_24px_-10px_rgba(227,28,37,0.7)] transition hover:-translate-y-0.5 hover:bg-cta-dark">Book a visit</a>
        <a href={site.phone.href} class="rounded-full bg-white px-7 py-3.5 font-semibold text-brand-dark ring-1 ring-ice transition hover:ring-brand">Call {site.phone.label}</a>
      </div>
      {highlights.length > 0 && (
        <ul class="hero-rise-3 mt-10 grid gap-3 sm:grid-cols-3 sm:gap-4">
          {highlights.map((h) => (
            <li class="flex items-start gap-2.5 text-[15px] leading-snug text-navy">
              <svg class="mt-0.5 size-5 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.7-9.3a1 1 0 0 0-1.4-1.4L9 10.6 7.7 9.3a1 1 0 1 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l4-4Z" clip-rule="evenodd"/></svg>
              {h}
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-none">
      <div class="hero-arch relative aspect-[4/5] overflow-hidden rounded-[999px_999px_1.5rem_1.5rem] shadow-[0_30px_60px_-30px_rgba(23,50,77,0.6)] ring-8 ring-white">
        <Photo folder={image.folder} name={image.name} alt={image.alt} loading="eager" widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 90vw" />
      </div>
      <div class="hero-rise-3 absolute -bottom-5 left-4 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 shadow-lg ring-1 ring-ice sm:left-0">
        <span class="grid size-10 place-items-center rounded-full bg-brand text-white">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        </span>
        <span class="text-sm leading-tight text-navy"><strong class="block font-semibold">6 clinics in Texas</strong>Dallas, Arlington, Mesquite and more</span>
      </div>
    </div>
  </div>
</section>
