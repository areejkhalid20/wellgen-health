---
// Page banner: text on the left, photo on the right with a steel-blue block offset behind it.
import Breadcrumbs from './Breadcrumbs.astro';
import Photo from './Photo.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  lead: string;
  crumbs: { label: string; href?: string }[];
  image: { folder: string; name: string; alt: string };
  highlights?: string[];
  /** Defaults to the main booking page and main phone number */
  bookHref?: string;
  /** Text of the red button (default "Book a visit") */
  bookLabel?: string;
  /** Full text of the second button, instead of "Call …" */
  callText?: string;
  call?: { label: string; href: string };
}
const { title, lead, crumbs, image, highlights = [], bookHref = site.bookingUrl, bookLabel = 'Book a visit', call = site.phone, callText } = Astro.props;
---
<section class="relative overflow-hidden bg-mist">
  
  <div class="relative mx-auto grid max-w-7xl gap-10 px-6 pb-14 pt-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:pb-20 lg:pt-12">
    <div class="flex flex-col justify-center">
      <div class="hero-rise"><Breadcrumbs items={crumbs} /></div>
      <h1 class="hero-rise mt-6 text-[2.6rem] font-medium leading-[1.05] tracking-[-0.01em] text-navy sm:text-5xl lg:text-[3.6rem]">{title}</h1>
      <p class="hero-rise-2 mt-5 max-w-[56ch] text-lg leading-relaxed text-muted">{lead}</p>
      <div class="hero-rise-3 mt-8 flex flex-wrap gap-3">
        <a href={bookHref} class="rounded-full bg-cta px-7 py-3.5 font-semibold text-white shadow-[0_10px_24px_-10px_rgba(227,28,37,0.7)] transition hover:-translate-y-0.5 hover:bg-cta-dark">{bookLabel}</a>
        <a href={call.href} class="rounded-full bg-white px-7 py-3.5 font-semibold text-brand-dark ring-1 ring-ice transition hover:ring-brand">{callText ?? `Call ${call.label}`}</a>
      </div>
      <slot />
      {highlights.length > 0 && (
        <ul class="hero-rise-3 mt-10 grid gap-3 sm:grid-cols-3 sm:gap-4">
          {highlights.map((h) => (
            <li class="flex items-start gap-2.5 text-[15px] leading-snug text-navy">
              <svg class="mt-0.5 size-5 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.7-9.3a1 1 0 0 0-1.4-1.4L9 10.6 7.7 9.3a1 1 0 1 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l4-4Z" clip-rule="evenodd"/></svg>
              {h}
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="relative mx-auto w-full max-w-md pb-6 pl-6 lg:max-w-none">
      <div aria-hidden="true" class="hero-rise-2 absolute bottom-0 left-0 h-[80%] w-[80%] rounded-[2rem] bg-brand"></div>
      <div class="hero-photo relative ml-auto mr-0 -translate-y-0 aspect-[5/6] overflow-hidden rounded-[2rem] shadow-[0_30px_60px_-30px_rgba(23,50,77,0.6)]">
        <Photo folder={image.folder} name={image.name} alt={image.alt} loading="eager" widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 90vw" />
      </div>
    </div>
  </div>
</section>
