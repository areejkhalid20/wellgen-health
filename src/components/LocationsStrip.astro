---
import Photo from './Photo.astro';
import { locations, telHref } from '../data/site';

interface Props { title?: string; }
const { title = 'Find a clinic near you' } = Astro.props;
---
<section class="bg-mist">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-3xl font-medium text-navy lg:text-4xl">{title}</h2>
      <a href="/locations/" class="font-semibold text-brand-dark hover:text-navy">See all locations</a>
    </div>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {locations.map((l) => (
        <li class="group flex gap-4 rounded-2xl bg-white p-3 ring-1 ring-ice transition hover:ring-brand/50">
          <div class="size-24 shrink-0 overflow-hidden rounded-xl bg-mist">
            <Photo folder="locations" name={l.slug} alt="" widths={[200]} sizes="96px" hint={false} />
          </div>
          <div class="py-1 text-[15px] leading-snug">
            <a href={`/locations/${l.slug}/`} class="font-display text-lg font-medium text-navy group-hover:text-brand-dark">{l.name}</a>
            <p class="mt-1 text-muted">{l.street}<br />{l.city}</p>
            <a href={telHref(l.phone)} class="mt-1 inline-block font-medium text-brand-dark">{l.phone}</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
