---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-muted">
    <li><a href="/" class="hover:text-brand-ink">Home</a></li>
    {items.map((item) => (
      <li class="flex items-center gap-2">
        <span aria-hidden="true" class="text-navy/30">›</span>
        {item.href ? (
          <a href={item.href} class="hover:text-brand-ink">{item.label}</a>
        ) : (
          <span aria-current="page" class="text-navy">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
