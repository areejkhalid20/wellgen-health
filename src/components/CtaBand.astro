---
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Ready to see a provider?',
  text = 'Book online in a few minutes, or call and our team will find a time and clinic that works for you.',
} = Astro.props;
---
<section class="px-6 py-16 lg:py-20">
  <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-brand-dark via-brand-dark to-brand px-8 py-14 text-white sm:px-14">
    <div aria-hidden="true" class="absolute -right-16 -top-20 size-80 rounded-full border-[36px] border-white/10"></div>
    <div aria-hidden="true" class="absolute -bottom-24 right-40 size-56 rounded-full bg-sky/25 blur-2xl"></div>
    <div class="relative grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="text-4xl font-medium leading-tight lg:text-5xl">{title}</h2>
        <p class="mt-4 max-w-[52ch] text-lg text-white/90">{text}</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <a href={site.bookingUrl} class="rounded-full bg-white px-7 py-3.5 font-semibold text-brand-dark shadow-lg transition hover:-translate-y-0.5">Book a visit</a>
        <a href={site.phone.href} class="rounded-full px-7 py-3.5 font-semibold text-white ring-2 ring-white/60 transition hover:bg-white/10">Call {site.phone.label}</a>
      </div>
    </div>
  </div>
</section>
