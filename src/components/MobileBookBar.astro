---
// Fixed Book / Call bar on phones and tablets. Hidden on large screens, where the header shows both.
import { site } from '../data/site';
---
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-ice bg-white/95 px-4 pb-[calc(0.75rem+env(safe-area-inset-bottom))] pt-3 backdrop-blur lg:hidden">
  <div class="mx-auto grid max-w-md grid-cols-2 gap-3">
    <a href={site.phone.href} class="flex items-center justify-center gap-2 rounded-full border border-brand/40 py-3 text-sm font-semibold text-brand-dark">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
      Call us
    </a>
    <a href={site.bookingUrl} class="flex items-center justify-center rounded-full bg-cta py-3 text-sm font-semibold text-white">Book online</a>
  </div>
</div>
