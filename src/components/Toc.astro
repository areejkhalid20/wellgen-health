---
// "On this page" guide. Stays in view on large screens and highlights the section you're reading.
interface Props {
  items: { slug: string; text: string }[];
}
const { items } = Astro.props;
---
<nav aria-label="On this page" class="toc sticky top-28">
  <p class="font-display text-lg font-medium text-navy">On this page</p>
  <ol class="mt-4 space-y-1 border-l-2 border-ice">
    {items.map((item) => (
      <li>
        <a
          href={`#${item.slug}`}
          data-toc-link={item.slug}
          class="-ml-[2px] block border-l-2 border-transparent py-1.5 pl-4 text-[15px] text-muted transition-colors hover:text-navy data-[active=true]:border-brand data-[active=true]:font-medium data-[active=true]:text-brand-dark"
        >{item.text}</a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [a.dataset.tocLink!, a]),
  );
  const setActive = (id: string) => links.forEach((a, key) => (a.dataset.active = String(key === id)));
  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible[0]) setActive(visible[0].target.id);
    },
    { rootMargin: '-20% 0px -65% 0px' },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
