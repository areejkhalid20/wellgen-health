---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { providers, providerBySlug, providerUrl, type Provider } from '../../data/providers';
import { site, locations, locationUrl, telHref, directionsUrl } from '../../data/site';
import { breadcrumbLd, faqLd } from '../../lib/schema';

export async function getStaticPaths() {
  const bios = await getCollection('providers');
  return bios
    .map((entry) => ({ entry, provider: providerBySlug(entry.id) }))
    .filter((x) => x.provider?.hasProfile)
    .map(({ entry, provider }) => ({ params: { slug: entry.id }, props: { entry, provider } }));
}

const { entry, provider: p } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'providers'>>>[number]; provider: Provider };
const { Content } = await render(entry);
const clinic = locations.find((l) => l.slug === p.location);
const fullName = `${p.name}, ${p.credentials}`;
// "Dr. Memon" for doctors, first name for everyone else
const firstName = p.name.startsWith('Dr.') ? `Dr. ${p.name.split(' ').pop()}` : p.name.split(' ')[0];
const callTo = clinic ? { label: clinic.phone, href: telHref(clinic.phone) } : site.phone;
const sameClinic = providers.filter((o) => o.slug !== p.slug && o.location === p.location && o.hasProfile).slice(0, 4);
const others = sameClinic.length ? sameClinic : providers.filter((o) => o.slug !== p.slug && o.hasProfile).slice(0, 4);
const SITE = 'https://wellgen-health.com';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.name,
  honorificSuffix: p.credentials,
  jobTitle: p.specialty,
  url: SITE + providerUrl(p),
  worksFor: clinic ? { '@id': `${SITE}/locations/${clinic.slug}/#clinic`, '@type': 'MedicalClinic', name: `WellGen Health ${clinic.name}` } : { '@type': 'MedicalOrganization', name: 'WellGen Health' },
};
---
<BaseLayout
  title={`${fullName}${clinic ? `, ${clinic.name}` : ''}`}
  description={entry.data.lead.slice(0, 155)}
  jsonLd={[
    breadcrumbLd([{ label: 'Providers', href: '/providers/' }, { label: p.name, href: providerUrl(p) }]),
    personLd,
    ...(entry.data.faqs.length ? [faqLd(entry.data.faqs)] : []),
  ]}
>
  <PageHero
    title={fullName}
    lead={p.specialty}
    crumbs={[{ label: 'Providers', href: '/providers/' }, { label: p.name }]}
    image={{ folder: 'providers', name: p.slug, alt: fullName }}
    bookHref={`${site.bookingUrl}?provider=${p.slug}${clinic ? `&location=${clinic.slug}` : ''}`}
    call={callTo}
  >
    {clinic && (
      <p class="hero-rise-3 mt-8 flex items-start gap-3 text-[17px] text-navy">
        <svg class="mt-0.5 size-6 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 1 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
        <span>{p.role} at <a href={locationUrl(clinic)} class="font-semibold text-brand-dark underline-offset-4 hover:underline">WellGen Health {clinic.name}</a><br /><span class="text-muted">{clinic.street}, {clinic.city}</span></span>
      </p>
    )}
  </PageHero>

  <div class="mx-auto grid max-w-7xl gap-14 px-6 pt-20 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-20 lg:pt-28">
    <article>
      <p class="max-w-[60ch] font-display text-2xl leading-snug text-navy lg:text-[1.75rem]">{entry.data.lead}</p>
      <div class="prose-wellgen mt-10">
        <Content />
      </div>
    </article>

    {clinic && (
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="overflow-hidden rounded-[1.75rem] bg-white ring-1 ring-ice">
          <div class="aspect-[16/10] bg-mist">
            <Photo folder="locations" name={clinic.slug} alt="" widths={[400, 640]} sizes="320px" hint={false} />
          </div>
          <div class="p-6">
            <p class="text-sm text-muted">See {firstName} at</p>
            <p class="mt-1 font-display text-2xl text-navy"><a href={locationUrl(clinic)} class="hover:text-brand-dark">WellGen Health {clinic.name}</a></p>
            <p class="mt-3 text-[15px] leading-relaxed text-muted">{clinic.street}<br />{clinic.city}</p>
            <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-[15px] font-semibold">
              <a href={telHref(clinic.phone)} class="text-brand-dark hover:text-navy">{clinic.phone}</a>
              <a href={directionsUrl(clinic)} target="_blank" rel="noopener" class="text-brand-dark hover:text-navy">Directions<span class="sr-only"> (opens Google Maps)</span></a>
            </div>
            <a href={`${site.bookingUrl}?provider=${p.slug}&location=${clinic.slug}`} class="mt-6 block rounded-full bg-cta px-6 py-3 text-center font-semibold text-white transition hover:bg-cta-dark">Book with {firstName}</a>
          </div>
        </div>
      </aside>
    )}
  </div>

  {entry.data.faqs.length > 0 && (
    <div class="mx-auto max-w-7xl px-6 pt-24 lg:pt-32">
      <Faq faqs={entry.data.faqs} title={`Questions about ${p.name}`} />
    </div>
  )}

  {others.length > 0 && (
    <section class="mx-auto max-w-7xl px-6 pt-24 lg:pt-32">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl font-medium text-navy lg:text-4xl">{sameClinic.length ? `Also at ${clinic?.name}` : 'Other WellGen Health providers'}</h2>
        <a href={sameClinic.length && clinic ? `/providers/?clinic=${clinic.slug}` : '/providers/'} class="font-semibold text-brand-dark hover:text-navy">See all providers</a>
      </div>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {others.map((o) => (
          <li class="group relative flex items-center gap-4 rounded-2xl bg-mist p-3">
            <div class="size-20 shrink-0 overflow-hidden rounded-xl bg-white">
              <Photo folder="providers" name={o.slug} alt="" widths={[160]} sizes="80px" hint={false} />
            </div>
            <div>
              <a href={providerUrl(o)} class="font-display text-lg font-medium leading-snug text-navy after:absolute after:inset-0 group-hover:text-brand-dark">{o.name}</a>
              <p class="text-sm text-muted">{o.credentials}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <CtaBand title={`Book an appointment with ${firstName}`} text={`Book online in a few minutes, or call ${clinic ? `the ${clinic.name} clinic` : 'us'} and we'll find a time that works for you.`} />
</BaseLayout>
