---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { pageFaqs } from '../lib/page-faqs';
import { breadcrumbLd, faqLd } from '../lib/schema';

const faqs = pageFaqs('/charge-capture/');
// App download links
const appStore = 'https://apps.apple.com/us/app/wellgen-app/id6741333214';
// WordPress links to an .apk.zip file in its uploads folder. Replace with the Google Play link once the app is listed there.
const android = 'https://wellgen-health.com/wp-content/uploads/2026/04/app-release.apk.zip';

const benefits = [
  'Access patient encounters and medical histories on the go',
  'Sync captured charges with your billing system in real time',
  'Reduce audit risk with accurate, compliant documentation',
  'Get paid faster by minimizing charge lag',
  'Round more efficiently with a mobile-first workflow',
  'Submit charges instantly, with no delays or lost revenue',
  'Stay fully compliant with HIPAA regulations',
  'Capture office visits, diagnoses, and procedures',
  'Assign CPT and ICD codes instantly from your phone',
];
const features = [
  { screen: 'screen-patients', title: 'Digital rounding list', text: 'A real-time patient census list on your phone. The list and your charges integrate directly with your EHR system.' },
  { screen: 'screen-demographics', title: 'Integrated data entry', text: 'Manage patient facesheets, notes, and charges in one system. Seamless EHR integration that syncs in real time removes duplicate entry and reduces errors.' },
  { screen: 'screen-follow-up', title: 'Easy patient handoff', text: 'With a single swipe, share patients with other physicians for handoff or weekend rounding. Instant, secure transfers and real-time updates keep care continuous.' },
  { screen: 'screen-charges', title: 'Mobile charge capture', text: 'Submit charges to your EHR or practice management system in seconds. Clone previous charges or pick from customized drill-downs, and capture every billable encounter at the point of care.' },
];
const screens = [
  ['screen-login', 'Sign in'], ['screen-patients', 'Patient list'], ['screen-demographics', 'Demographics'], ['screen-charges', 'Charges'],
  ['screen-diagnosis', 'Diagnosis codes'], ['screen-procedures', 'Procedures'], ['screen-follow-up', 'Follow-up'],
];
const check = 'M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z';

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'WellGen Charge Capture',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'iOS, Android',
  description: 'HIPAA-compliant mobile charge capture app for physicians and clinical staff, with EHR integration.',
  url: 'https://wellgen-health.com/charge-capture/',
  installUrl: appStore,
  publisher: { '@type': 'Organization', name: 'WellGen Health', url: 'https://wellgen-health.com' },
};
---
<BaseLayout
  title="Mobile charge capture app for healthcare providers"
  description="Streamline billing and stop revenue leakage. WellGen's HIPAA-compliant mobile charge capture app integrates directly with your EHR."
  jsonLd={[breadcrumbLd([{ label: 'Products', href: '/charge-capture/' }, { label: 'WellGen Charge Capture', href: '/charge-capture/' }]), appLd, ...(faqs.length ? [faqLd(faqs)] : [])]}
>
  <section class="relative overflow-hidden bg-navy text-white">
    <div aria-hidden="true" class="absolute -right-40 top-10 size-[38rem] rounded-full bg-sky/20 blur-3xl"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-6 pb-10 pt-10 lg:grid-cols-[1fr_1fr] lg:pb-0 lg:pt-14">
      <div class="lg:pb-20">
        <div class="hero-rise [&_a]:text-white/70 [&_a:hover]:text-white [&_li]:text-white/60 [&_[aria-current]]:text-white">
          <Breadcrumbs items={[{ label: 'Products' }, { label: 'WellGen Charge Capture' }]} />
        </div>
        <p class="hero-rise mt-6 font-medium text-sky">For physicians and clinical staff</p>
        <h1 class="hero-rise mt-2 text-5xl font-medium leading-[1.04] tracking-[-0.01em] lg:text-[4rem]">WellGen Charge Capture</h1>
        <p class="hero-rise-2 mt-5 max-w-[48ch] text-lg text-white/85">Record and submit professional charges in real time, at the point of care, from your phone. Secure, simple and HIPAA-compliant.</p>
        <div class="hero-rise-3 mt-8 flex flex-wrap gap-3">
          <a href={appStore} target="_blank" rel="noopener" class="inline-flex items-center gap-3 rounded-2xl bg-white px-5 py-3 text-navy transition hover:-translate-y-0.5">
            <svg class="size-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2.1-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.4.8c1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.7-1-2.7-4.1ZM13.9 4.9c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5Z"/></svg>
            <span class="text-left leading-tight"><span class="block text-xs">Download on the</span><span class="block text-lg font-semibold">App Store</span></span>
          </a>
          <a href={android} class="inline-flex items-center gap-3 rounded-2xl px-5 py-3 text-white ring-1 ring-white/30 transition hover:bg-white/10">
            <svg class="size-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.6 9.5 19.4 6.4a.4.4 0 1 0-.7-.4l-1.8 3.1A11 11 0 0 0 12 8c-1.7 0-3.4.4-4.9 1.1L5.3 6a.4.4 0 1 0-.7.4l1.8 3.1A9.7 9.7 0 0 0 1.5 17h21a9.7 9.7 0 0 0-4.9-7.5ZM7 14.2a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm10 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/></svg>
            <span class="text-left leading-tight"><span class="block text-xs">Download for</span><span class="block text-lg font-semibold">Android</span></span>
          </a>
        </div>
      </div>
      <div class="hero-rise-2 relative mx-auto flex h-[26rem] w-full max-w-lg items-end justify-center sm:h-[32rem]" aria-hidden="true">
        <div class="absolute bottom-0 left-[4%] w-[52%] -rotate-6 drop-shadow-2xl"><Photo folder="pages/charge-capture" name="screen-login" alt="" widths={[400, 700]} sizes="18rem" loading="eager" hint={false} /></div>
        <div class="absolute bottom-0 right-[4%] w-[56%] rotate-3 drop-shadow-2xl"><Photo folder="pages/charge-capture" name="screen-patients" alt="" widths={[400, 700]} sizes="20rem" loading="eager" hint={false} /></div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pt-20 lg:pt-28">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <h2 class="text-4xl font-medium leading-tight text-navy lg:text-5xl">Say goodbye to paper superbills</h2>
      <div class="space-y-5 text-[17px] leading-relaxed text-ink">
        <p class="font-display text-2xl leading-snug text-navy">Traditional charge capture is slow, error-prone, and leads to missed or delayed charges that hurt your practice’s revenue.</p>
        <p>WellGen digitizes the whole charge capture workflow. No more paper superbills or end-of-day charge entry: every patient encounter is documented accurately and submitted instantly.</p>
        <p>Physicians and clinical staff can record encounters, assign CPT and ICD-10 codes, and submit charges anytime, anywhere. Whether you’re rounding in a hospital, seeing patients in a clinic, or working remotely, WellGen keeps your revenue cycle moving.</p>
      </div>
    </div>

    <ul class="mt-14 grid gap-5 md:grid-cols-2">
      <li class="rounded-[1.75rem] bg-mist p-8">
        <h3 class="font-display text-2xl text-navy">A complete solution</h3>
        <p class="mt-2 text-[16px] leading-relaxed text-muted">An efficient, controlled charge capture process built for large healthcare organizations.</p>
      </li>
      <li class="rounded-[1.75rem] bg-mist p-8">
        <h3 class="font-display text-2xl text-navy">Works where you do</h3>
        <p class="mt-2 text-[16px] leading-relaxed text-muted">Available on phones, tablets, and desktops.</p>
      </li>
    </ul>
  </section>

  <!-- Benefits -->
  <section class="mx-auto max-w-7xl px-6 pt-24 lg:pt-32">
    <h2 class="max-w-2xl text-4xl font-medium leading-tight text-navy lg:text-5xl">Patient information at your fingertips</h2>
    <ul class="mt-10 grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
      {benefits.map((b) => <li class="flex gap-3 text-[16px] text-ink"><svg class="mt-0.5 size-5 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={check} clip-rule="evenodd"/></svg>{b}</li>)}
    </ul>
  </section>

  <!-- Features with screens -->
  <section class="mx-auto max-w-7xl space-y-20 px-6 pt-24 lg:space-y-28 lg:pt-32">
    {features.map((f, i) => (
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-20">
        <div class:list={['relative mx-auto w-full max-w-md rounded-[2.5rem] bg-mist px-10 pt-10', i % 2 === 1 && 'lg:order-2']}>
          <Photo folder="pages/charge-capture" name={f.screen} alt={`${f.title} screen in the WellGen Charge Capture app`} widths={[400, 700]} sizes="(min-width: 1024px) 28rem, 90vw" class="drop-shadow-xl" />
        </div>
        <div>
          <p class="font-display text-2xl text-brand-dark">0{i + 1}</p>
          <h3 class="mt-2 text-3xl font-medium text-navy lg:text-4xl">{f.title}</h3>
          <p class="mt-4 max-w-[48ch] text-[17px] leading-relaxed text-ink">{f.text}</p>
        </div>
      </div>
    ))}
  </section>

  <!-- All screens -->
  <section class="pt-24 lg:pt-32">
    <div class="mx-auto max-w-7xl px-6">
      <h2 class="text-3xl font-medium text-navy lg:text-4xl">A look inside the app</h2>
    </div>
    <div class="mt-8 overflow-x-auto pb-4 [scrollbar-width:thin]" tabindex="0" aria-label="App screens">
      <ul class="mx-auto flex w-max gap-6 px-6 lg:px-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))]">
        {screens.map(([name, label]) => (
          <li class="w-56 shrink-0">
            <div class="rounded-[2rem] bg-mist px-5 pt-6"><Photo folder="pages/charge-capture" name={name} alt={`${label} screen`} widths={[300, 500]} sizes="14rem" hint={false} /></div>
            <p class="mt-3 text-center text-[15px] text-muted">{label}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {faqs.length > 0 && (
    <div class="mx-auto max-w-7xl px-6 pt-24 lg:pt-32"><Faq faqs={faqs} title="Questions about WellGen Charge Capture" /></div>
  )}

  <CtaBand
    title="See WellGen Charge Capture in action"
    text="Tell us about your practice and we’ll show you how mobile charge capture fits your workflow and EHR."
    primary={{ label: 'Contact us', href: '/company/contact/' }}
    secondary={{ label: 'Download on the App Store', href: appStore }}
  />
</BaseLayout>
