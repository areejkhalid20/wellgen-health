---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, categoryUrl } from '../data/services';
import { site } from '../data/site';
---
<BaseLayout title={site.name}>
  <section class="bg-brand text-navy">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:py-28">
      <p class="text-sm font-semibold uppercase tracking-widest text-navy/70">Phase 1 preview</p>
      <h1 class="mt-3 max-w-2xl text-4xl font-medium leading-tight lg:text-5xl">{site.tagline}</h1>
      <p class="mt-5 max-w-xl text-navy/80">
        The home page is built in phase 8. For now this page is here so you can check the header, menus and footer.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={site.bookingUrl} class="rounded-md bg-cta px-6 py-3 font-semibold text-white hover:bg-cta-dark">Book Online</a>
        <a href={site.phone.href} class="rounded-md border border-navy/30 bg-white/20 px-6 py-3 font-medium text-navy hover:bg-white/40">Call {site.phone.label}</a>
      </div>
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-2xl font-medium text-navy">What to check in phase 1</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        <li class="rounded-lg bg-white p-5 shadow-sm"><strong class="text-navy">Services menu:</strong> hover or click Services; each category and service links to its new URL.</li>
        <li class="rounded-lg bg-white p-5 shadow-sm"><strong class="text-navy">Mobile menu:</strong> narrow the window; open the menu and expand Services, then a category.</li>
        <li class="rounded-lg bg-white p-5 shadow-sm"><strong class="text-navy">Keyboard:</strong> Tab through the header; Enter opens a menu, Escape closes it.</li>
        <li class="rounded-lg bg-white p-5 shadow-sm"><strong class="text-navy">404 page:</strong> open <a class="text-brand-ink underline" href="/this-page-does-not-exist/">a page that does not exist</a>.</li>
      </ul>
      <h2 class="mt-12 text-2xl font-medium text-navy">Service categories</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {categories.map((c) => (
          <a href={categoryUrl(c)} class="rounded-lg border border-navy/10 bg-white p-5 hover:border-brand">
            <span class="block font-medium text-navy">{c.name}</span>
            <span class="mt-1 block text-sm text-muted">{c.services.length} services</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
