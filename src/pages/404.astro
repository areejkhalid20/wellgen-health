---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, categoryUrl } from '../data/services';
import { site } from '../data/site';
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <section class="mx-auto max-w-3xl px-6 py-20 text-center lg:py-28">
    <p class="text-sm font-semibold uppercase tracking-widest text-brand-ink">Error 404</p>
    <h1 class="mt-3 text-4xl font-medium text-navy lg:text-5xl">We couldn't find that page</h1>
    <p class="mx-auto mt-5 max-w-xl text-muted">
      The page may have moved when we updated our website. Try one of the links below, or call us and we'll help you find what you need.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-md bg-navy px-6 py-3 font-semibold text-white hover:bg-navy/90">Go to home page</a>
      <a href={site.bookingUrl} class="rounded-md bg-cta px-6 py-3 font-semibold text-white hover:bg-cta-dark">Book Online</a>
      <a href={site.phone.href} class="rounded-md border border-navy/20 px-6 py-3 font-medium text-navy hover:bg-surface">Call {site.phone.label}</a>
    </div>
  </section>
  <section class="bg-surface">
    <div class="mx-auto grid max-w-5xl gap-4 px-6 py-12 md:grid-cols-3">
      {categories.map((c) => (
        <a href={categoryUrl(c)} class="rounded-lg bg-white p-5 shadow-sm hover:shadow-md">
          <span class="block font-medium text-navy">{c.name}</span>
          <span class="mt-1 block text-sm text-muted">{c.summary}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
