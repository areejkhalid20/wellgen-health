---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, categoryUrl } from '../data/services';
import { site } from '../data/site';
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <section class="mx-auto max-w-3xl px-6 py-20 text-center lg:py-28">
    <p class="font-display text-7xl font-medium text-brand">404</p>
    <h1 class="mt-3 text-4xl font-medium text-navy lg:text-5xl">We couldn't find that page</h1>
    <p class="mx-auto mt-5 max-w-xl text-muted">
      The page may have moved when we updated our website. Try one of the links below, or call us and we'll help you find what you need.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-brand-dark px-6 py-3 font-semibold text-white hover:bg-navy">Go to home page</a>
      <a href={site.bookingUrl} class="rounded-full bg-cta px-6 py-3 font-semibold text-white hover:bg-cta-dark">Book Online</a>
      <a href={site.phone.href} class="rounded-full border border-navy/20 px-6 py-3 font-medium text-navy hover:bg-surface">Call {site.phone.label}</a>
    </div>
  </section>
  <section class="bg-surface">
    <div class="mx-auto grid max-w-5xl gap-4 px-6 py-12 md:grid-cols-3">
      {categories.map((c) => (
        <a href={categoryUrl(c)} class="rounded-2xl bg-white p-5 ring-1 ring-ice transition hover:ring-brand">
          <span class="block font-display text-lg font-medium text-navy">{c.name}</span>
          <span class="mt-1 block text-sm text-muted">{c.summary}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
