---
// Placeholder: the real Category template is built in phase 2.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { categories, servicesHubUrl, serviceUrl, type Category } from '../../../data/services';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}
const { category } = Astro.props as { category: Category };
---
<BaseLayout title={category.name} description={category.summary}>
  <div class="mx-auto max-w-7xl px-6 py-12">
    <Breadcrumbs items={[{ label: 'Services', href: servicesHubUrl }, { label: category.name }]} />
    <h1 class="mt-4 text-4xl font-medium text-navy">{category.name}</h1>
    <p class="mt-3 text-muted">Placeholder page. The full category page is built in phase 2.</p>
    <ul class="mt-8 grid gap-3 md:grid-cols-2">
      {category.services.map((s) => (
        <li><a href={serviceUrl(category, s)} class="block rounded-lg border border-navy/10 p-4 text-navy hover:border-brand">{s.name}</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>
