---
// Service overview page. If the service has detail pages (src/content/topics/<service>/), they appear as a numbered path.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import TopicChapters from '../../../components/TopicChapters.astro';
import Faq from '../../../components/Faq.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import LocationsStrip from '../../../components/LocationsStrip.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { categories, categoryUrl, servicesHubUrl, serviceUrl, type Category, type Service } from '../../../data/services';
import { getTopics, topicUrl } from '../../../lib/topics';
import { breadcrumbLd, faqLd, medicalPageLd } from '../../../lib/schema';

export function getStaticPaths() {
  return categories.flatMap((category) =>
    category.services.map((service) => ({
      params: { category: category.slug, service: service.slug },
      props: { category, service },
    })),
  );
}
const { category, service } = Astro.props as { category: Category; service: Service };
const path = serviceUrl(category, service);

// Overview text: src/content/services/<slug>.md. Pages without a file yet show a short version.
const entry = (await getCollection('services')).find((e) => e.id === service.slug);
const rendered = entry ? await render(entry) : undefined;
const faqs = entry?.data.faqs ?? [];
const topics = await getTopics(service.slug);
const chapters = topics.map((t) => ({
  href: topicUrl(category, service, t.slug),
  title: t.data.title,
  summary: t.data.summary,
  points: t.data.points,
}));

const related = category.services.filter((s) => s.slug !== service.slug).slice(0, 3);
const crumbs = [
  { label: 'Services', href: servicesHubUrl },
  { label: category.name, href: categoryUrl(category) },
  { label: service.name },
];
const jsonLd = [
  breadcrumbLd([
    { label: 'Services', href: servicesHubUrl },
    { label: category.name, href: categoryUrl(category) },
    { label: service.name, href: path },
  ]),
  medicalPageLd(service.name, service.summary, path),
  ...(faqs.length ? [faqLd(faqs)] : []),
];
---
<BaseLayout title={service.name} description={service.summary} jsonLd={jsonLd}>
  <PageHero
    title={service.name}
    lead={entry?.data.lead ?? service.summary}
    crumbs={crumbs}
    image={{ folder: 'services', name: service.slug, alt: entry?.data.heroAlt ?? service.name }}
    highlights={entry?.data.highlights}
  />

  {rendered ? (
    <section class="mx-auto max-w-7xl px-6 pt-20 lg:pt-28">
      <article class="prose-wellgen mx-auto lg:mx-0">
        <rendered.Content />
      </article>
    </section>
  ) : (
    <div class="mx-auto max-w-3xl px-6 pt-24 text-center">
      <p class="text-lg text-muted">The full {service.name} page is on its way. In the meantime, call us or book a visit and our team will help.</p>
    </div>
  )}

  {chapters.length > 0 && (
    <div class="mx-auto max-w-5xl px-6 pt-20 lg:pt-24">
      <TopicChapters serviceName={service.name} chapters={chapters} />
    </div>
  )}

  {faqs.length > 0 && (
    <div class="mx-auto max-w-7xl px-6 pt-24">
      <Faq faqs={faqs} />
    </div>
  )}

  {related.length > 0 && (
    <section class="mx-auto max-w-7xl px-6 py-24">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl font-medium text-navy lg:text-4xl">Related care</h2>
        <a href={categoryUrl(category)} class="font-semibold text-brand-dark hover:text-navy">All {category.name.toLowerCase()}</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((s) => (
          <ServiceCard href={serviceUrl(category, s)} name={s.name} summary={s.summary} image={{ folder: 'services', name: s.slug }} />
        ))}
      </div>
    </section>
  )}

  <LocationsStrip />
  <CtaBand />
</BaseLayout>
