---
// Placeholder: the real Services hub template is built in phase 2.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { categories, categoryUrl, serviceUrl } from '../../data/services';
---
<BaseLayout title="Services">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <Breadcrumbs items={[{ label: 'Services' }]} />
    <h1 class="mt-4 text-4xl font-medium text-navy">Our services</h1>
    <p class="mt-3 text-muted">Placeholder page. The full Services hub is built in phase 2.</p>
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {categories.map((c) => (
        <div>
          <a href={categoryUrl(c)} class="text-lg font-medium text-navy hover:text-brand-ink">{c.name}</a>
          <ul class="mt-3 space-y-1 text-sm">
            {c.services.map((s) => <li><a href={serviceUrl(c, s)} class="text-brand-ink hover:underline">{s.name}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
