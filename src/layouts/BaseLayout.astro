---
import '@fontsource-variable/rubik';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBookBar from '../components/MobileBookBar.astro';
import seoData from '../data/seo.json';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Structured data objects (schema.org) for this page */
  jsonLd?: Record<string, unknown>[];
}
const props = Astro.props;
const path = Astro.url.pathname;
// SEO from src/data/seo.json wins when the page has an entry there.
const seo = (seoData as Record<string, any>)[path];
const title = seo?.title ?? props.title;
const description = seo?.description ?? props.description ?? 'Primary and specialty care across six WellGen Health clinics in Texas.';
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(path, Astro.site);
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';

const org = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: site.name,
  url: Astro.site?.toString(),
  telephone: '+1-844-886-7362',
  email: site.email,
};
const jsonLd = [org, ...(props.jsonLd ?? [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#4682b3" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="flex min-h-dvh flex-col pb-[4.5rem] lg:pb-0">
    <a href="#main" class="sr-only z-[60] rounded-md bg-navy px-4 py-2 text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileBookBar />
  </body>
</html>
